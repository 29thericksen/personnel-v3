<% content_for(:page_title) { "#{@user.short_name} - Attendance" } %>

<% stats_note = "Attendance percentages are calculated from a member's mandatory drills. " \
  "Non-Mandatory or Guested Drills are not included." %>
<h2>
  Attendance
  <span class="user-attendance-info" title="<%= stats_note %>" aria-label="<%= stats_note %>"
        tabindex="0" data-toggle="tooltip" data-controller="tooltip">
    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
  </span>
</h2>

<dl class="user-attendance-stats">
  <dt>Last 30 days:</dt>
  <dd><%= @attendance_stats.last_30_days.round %>%</dd>

  <dt>Last 60 days:</dt>
  <dd><%= @attendance_stats.last_60_days.round %>%</dd>

  <dt>Last 90 days:</dt>
  <dd><%= @attendance_stats.last_90_days.round %>%</dd>

  <dt>Total:</dt>
  <dd><%= @attendance_stats.total.round %>%</dd>
</dl>

<ul class="nav nav-pills user-attendance-filters">
  <% {"all" => "All Drills", "required" => "Required Drills", "guested" => "Guested Drills"}.each do |filter, label| %>
    <li class="nav-item">
      <%= link_to user_attendance_path(@user, filter: (filter unless filter == "all")),
            class: class_names("nav-link", active: @filter == filter) do %>
        <%= label %>
        <span class="badge badge-light"><%= @filter_counts[filter] %></span>
      <% end %>
    </li>
  <% end %>
</ul>

<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">Date</th>
      <th scope="col">Event</th>
      <th scope="col">Mandatory</th>
      <th scope="col">Attendance</th>
    </tr>
  </thead>
  <tbody>
  <% @events.each do |event| %>
    <% attendance_record = @attendance_records[event.id] %>
    <tr>
      <td><%= timestamp_tag event.starts_at %></td>
      <td><%= link_to event.title, event %></td>
      <% if attendance_record.nil? %>
        <td>&mdash;</td>
        <td><span class="badge badge-info">Guest</span></td>
      <% else %>
        <td><%= event.mandatory %></td>
        <td>
          <% if !attendance_record.attended %>
            <% if attendance_record.excused %>
              <% if policy(ExtendedLOA).index? &&
                attendance_record.excused_by_extended_loa? %>
                <span class="badge badge-secondary">Extended LOA</span>
              <% else %>
                <span class="badge badge-secondary">Excused</span>
              <% end %>
            <% else %>
              <% if event.mandatory %>
                <span class="badge badge-danger">AWOL</span>
              <% else %>
                <span class="badge badge-warning">Absent</span>
              <% end %>
            <% end %>
          <% else %>
            <span class="badge badge-success">Attended</span>
          <% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
  <% if @events.empty? %>
    <tr>
      <td colspan="4" class="text-muted">No drills to show.</td>
    </tr>
  <% end %>
  </tbody>
</table>

<%= paginate @events %>
