<%# list_partial renders each unit's members: links on the event page, checkboxes on the AAR form %>
<% list_partial = local_assigns.fetch(:list_partial, "attendance_list") %>
<% list_locals = local_assigns.fetch(:list_locals, {}) %>
<%# A squad drill (one unit, no sub-units) needs no heading %>
<% show_heading = !(top && group.children.empty?) %>
<div class="attendance-group">
  <% if show_heading %>
    <div class="attendance-group-heading">
      <%# Unit names carry their full path ("Able Company, First Platoon"); under a parent, drop its part %>
      <span><%= parent ? group.unit.name.delete_prefix("#{parent.name}, ") : group.unit.name %></span>
      <% unless top %><%# the summary above already gives the event total %>
        <% members = group.all_entries %>
        <span>
          <% if attendance_taken %>
            <%= members.count { |entry| entry.status == :attended } %>/<%= members.size %>
          <% else %>
            <%= members.size %>
          <% end %>
        </span>
      <% end %>
    </div>
  <% end %>
  <% if group.entries.any? %>
    <%= render list_partial, entries: group.entries, **list_locals %>
  <% end %>
  <% group.children.each do |child| %>
    <%= render "attendance_group", group: child, parent: group.unit, top: false, attendance_taken: attendance_taken,
      list_partial: list_partial, list_locals: list_locals %>
  <% end %>
</div>
