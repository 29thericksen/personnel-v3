<%# The totals (summary line and bar) render above the AAR: see _attendance_summary %>
<% if roster.entries.any? %>
  <h4><%= roster.attendance_taken? ? "Attendance" : "Expected" %></h4>

  <%= render "attendance_group", group: roster.root, parent: nil, top: true, attendance_taken: roster.attendance_taken? %>

  <% if roster.other.any? %>
    <div class="attendance-group">
      <div class="attendance-group-heading"><span>Other</span><span><%= roster.other.size %></span></div>
      <%= render "attendance_list", entries: roster.other %>
    </div>
  <% end %>

  <% unless roster.attendance_taken? %>
    <p class="text-muted small mt-2">Attendance is recorded when the AAR is posted.</p>
  <% end %>
<% end %>
