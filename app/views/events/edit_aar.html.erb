<% content_for(:page_title) { "Post AAR" } %>

<article>
  <h1>Post AAR</h1>
  <h2 class="text-muted">
    <%= @event.title %> on <%= @event.datetime.strftime("%F %R") %>
  </h2>
  
  <%= simple_form_for @event, url: aar_event_path(@event), method: :patch do |f| %>
    <div class="row">
      <div class="col-4">
        <label class="font-weight-bold">Attendance</label>
        <%# Always sent, so unchecking everyone still submits the field %>
        <%= hidden_field_tag "event[user_ids][]", "", id: nil %>
        <%= render "attendance_group", group: @roster.root, parent: nil, top: true, attendance_taken: false,
          list_partial: "attendance_checkboxes", list_locals: {attended_user_ids: @attended_user_ids} %>
      </div>
      <div class="col-8">
        <%= render "guest_picker", event: @event, guests: @guests %>
        <%= f.input :report, input_html: {rows: 10} %>
        <%= f.button :submit, "Update AAR", class: 'btn-primary' %>
      </div>
    </div>
  <% end %>
</article>
